<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS settings shared by AWSIM and the ROS 2 tools of this repository.

  * Point clouds of the infrastructure LiDAR are several MB per message. With the
    default socket receive buffer, samples are dropped ("the cloud sometimes does not
    arrive"). Also raise the kernel limit:  sudo sysctl -w net.core.rmem_max=2147483647
  * Traffic stays on the loopback interface, so that point clouds do not flood the
    local network. To use AWSIM from another machine, replace 127.0.0.1 by the
    network interface address and set AllowMulticast to true (or list the peers).
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
    <Domain id="any">
        <General>
            <Interfaces>
                <NetworkInterface address="127.0.0.1" />
            </Interfaces>
            <AllowMulticast>false</AllowMulticast>
        </General>
        <Internal>
            <SocketReceiveBufferSize min="20MB" />
        </Internal>
        <Discovery>
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
            <Peers>
                <Peer address="127.0.0.1" />
            </Peers>
        </Discovery>
    </Domain>
</CycloneDDS>
